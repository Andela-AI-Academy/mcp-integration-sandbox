{
  "permissions": {
    "deny": [
      "Write(ops.db)",
      "Edit(ops.db)",
      "Read(.env)",
      "Read(.env.*)"
    ],
    "ask": [
      "Bash(git push *)"
    ],
    "allow": [
      "Bash(make seed)",
      "Bash(make verify)",
      "Bash(make selftest)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-ops-db.sh"
          }
        ]
      }
    ]
  }
}
